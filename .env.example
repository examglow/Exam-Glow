# ── Supabase (required for admin panel) ──────────────────────────────────────
# 1. Go to https://supabase.com → New project (free)
# 2. Settings → API → copy Project URL and anon/public key
# 3. In Supabase SQL editor run the SQL from src/lib/supabase-schema.sql
# 4. Copy this file to .env.local and fill in the values

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_PAYPAL_CLIENT_ID=your-paypal-client-id-here

# ── AI tutor providers ───────────────────────────────────────────────────────
# Cloudflare Workers AI is the default and needs NO key:
#   • Deployed: uses the `AI` binding already declared in wrangler.json.
#   • Local dev: reuses the credential from `wrangler login`. That OAuth token
#     expires hourly, so the first request after an hour costs ~8s while it is
#     refreshed; later requests are 0.5–3s. To skip that entirely, create a
#     non-expiring token (dash.cloudflare.com → My Profile → API Tokens,
#     "Workers AI: Read + Edit") and add CLOUDFLARE_API_TOKEN= to .env.local.
# Free tier: ~10,000 neurons/day ≈ 1,200 replies on llama-3.1-8b (or ~300 on 70b).

# ── Gemini AI tutor (optional secondary provider) ────────────────────────────
# Free key: https://aistudio.google.com → Create API key
# Local dev:  add the GEMINI_API_KEY= line to .env.local, then restart npm run dev
#             (the dev server now loads .env.local itself — no `set` needed)
# Production: npx wrangler secret put GEMINI_API_KEY
GEMINI_API_KEY=your-gemini-key-here
